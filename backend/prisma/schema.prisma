generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Supabase owns auth.users and the user_profiles.id -> auth.users.id cascade FK.
// Canonical SQL also owns RLS, grants, signup triggers/functions and migration metadata.
// Prisma must not replace those platform objects.
model User {
  id                    String         @id @db.Uuid
  name                  String?
  skinType              String?
  currentSkinScore      Int            @default(0)
  streakCount           Int            @default(0)
  onboardingCompleted   Boolean        @default(false)
  allergies             String?
  currentMedications    String?
  skinConcerns          String?
  joinDate              DateTime       @default(now()) @db.Timestamp(3)
  createdAt             DateTime       @default(now()) @db.Timestamp(3)
  updatedAt             DateTime       @default(now()) @updatedAt @db.Timestamp(3)
  dermatologistId       String?        @db.Uuid
  appointments          Appointment[]
  prescriptions         Prescription[]
  skinPhotos            SkinPhoto[]
  subscriptions         Subscription[]
  assignedDermatologist Dermatologist? @relation(fields: [dermatologistId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  photoCleanups PhotoCleanup[]
  routines Routine[]
  careRoutineRevisions CareRoutineRevision[]
  careRoutineCompletions CareRoutineCompletion[]
  careForms CareFormRevision[]
  careResponses CareFormResponse[]

  @@index([dermatologistId], map: "idx_user_profiles_dermatologist")
  @@map("user_profiles")
}

model Dermatologist {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  email           String         @unique
  password        String
  title           String?
  specialization  String?
  profileImageUrl String?
  phone           String?
  isAvailable     Boolean        @default(true)
  createdAt       DateTime       @default(now()) @db.Timestamp(3)
  updatedAt       DateTime       @default(now()) @updatedAt @db.Timestamp(3)
  appointments    Appointment[]
  prescriptions   Prescription[]
  patients        User[]
  careRoutineRevisions CareRoutineRevision[]
  photoReviews PhotoReview[]
  careTemplates CareTemplateRevision[]
  careForms CareFormRevision[]

  @@map("dermatologists")
}

model Appointment {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scheduledDate   DateTime      @db.Timestamp(3)
  duration        Int           @default(30)
  type            String
  status          String        @default("scheduled")
  concern         String?
  notes           String?
  visitNotes      String?
  videoCallURL    String?
  createdDate     DateTime      @default(now()) @db.Timestamp(3)
  createdAt       DateTime      @default(now()) @db.Timestamp(3)
  updatedAt       DateTime      @default(now()) @updatedAt @db.Timestamp(3)
  patientId       String        @db.Uuid
  dermatologistId String        @db.Uuid
  dermatologist   Dermatologist @relation(fields: [dermatologistId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  patient         User          @relation(fields: [patientId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  relatedPhotos   SkinPhoto[]

  @@index([dermatologistId], map: "idx_appointments_dermatologist")
  @@index([patientId], map: "idx_appointments_patient")
  @@map("appointments")
}

model Prescription {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  medicationName   String
  dosage           String
  instructions     String
  prescribedDate   DateTime      @default(now()) @db.Timestamp(3)
  expiryDate       DateTime?     @db.Timestamp(3)
  refillsRemaining Int           @default(0)
  isActive         Boolean       @default(true)
  pharmacy         String?
  createdAt        DateTime      @default(now()) @db.Timestamp(3)
  updatedAt        DateTime      @default(now()) @updatedAt @db.Timestamp(3)
  patientId        String        @db.Uuid
  dermatologistId  String        @db.Uuid
  productId        String?       @db.Uuid
  prescribedBy     Dermatologist @relation(fields: [dermatologistId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  patient          User          @relation(fields: [patientId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  relatedProduct   Product?      @relation(fields: [productId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([patientId], map: "idx_prescriptions_patient")
  @@map("prescriptions")
}

model Message {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  content        String
  sentDate       DateTime @default(now()) @db.Timestamp(3)
  isRead         Boolean  @default(false)
  messageType    String   @default("text")
  attachmentUrl  String?
  attachmentType String?
  createdAt      DateTime @default(now()) @db.Timestamp(3)
  updatedAt      DateTime @default(now()) @updatedAt @db.Timestamp(3)
  senderId       String
  senderType     String   @default("patient") // 'patient' or 'dermatologist'
  recipientId    String
  recipientType  String   @default("dermatologist") // 'patient' or 'dermatologist'

  @@map("messages")
}

model Product {
  id                     String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                   String
  brand                  String?
  category               String
  price                  Decimal        @db.Decimal(65, 30)
  productDescription     String?
  ingredients            String?
  imageUrl               String?
  isAvailable            Boolean        @default(true)
  isPrescriptionRequired Boolean        @default(false)
  createdAt              DateTime       @default(now()) @db.Timestamp(3)
  updatedAt              DateTime       @default(now()) @updatedAt @db.Timestamp(3)
  prescriptions          Prescription[]
  subscriptions          Subscription[]

  @@map("products")
}

model Subscription {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  startDate        DateTime @default(now()) @db.Timestamp(3)
  nextDeliveryDate DateTime @db.Timestamp(3)
  frequency        String
  quantity         Int      @default(1)
  status           String   @default("active")
  totalPrice       Decimal  @db.Decimal(65, 30)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now()) @db.Timestamp(3)
  updatedAt        DateTime @default(now()) @updatedAt @db.Timestamp(3)
  userId           String   @db.Uuid
  productId        String   @db.Uuid
  product          Product  @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  user             User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@map("subscriptions")
}

model SkinPhoto {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  photoUrl           String
  skinScore          Int          @default(0)
  notes              String?
  captureDate        DateTime     @default(now()) @db.Timestamp(3)
  createdAt          DateTime     @default(now()) @db.Timestamp(3)
  updatedAt          DateTime     @default(now()) @updatedAt @db.Timestamp(3)
  userId             String       @db.Uuid
  appointmentId      String?      @db.Uuid
  relatedAppointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  user               User         @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  review PhotoReview?

  @@index([userId], map: "idx_skin_photos_user")
  @@map("skin_photos")
}

model Routine {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  timeOfDay      String
  isActive       Boolean       @default(true)
  completedToday Boolean       @default(false)
  userId         String        @db.Uuid
  createdAt      DateTime      @default(now()) @db.Timestamp(3)
  updatedAt      DateTime      @default(now()) @updatedAt @db.Timestamp(3)
  steps          RoutineStep[]

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@map("routines")
}

model RoutineStep {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productName  String
  productType  String?
  instructions String?
  duration     Int      @default(0)
  orderIndex   Int      @default(0)
  isCompleted  Boolean  @default(false)
  createdAt    DateTime @default(now()) @db.Timestamp(3)
  updatedAt    DateTime @default(now()) @updatedAt @db.Timestamp(3)
  routineId    String   @db.Uuid
  routine      Routine  @relation(fields: [routineId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@map("routine_steps")
}


model CareRoutineRevision {
  id String @id @db.Uuid
  userId String @db.Uuid
  timeOfDay String
  version Int
  createdBy String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamp(3)
  name String
  isActive Boolean
  steps Json
  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  author Dermatologist @relation(fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  completions CareRoutineCompletion[]

  @@unique([userId, timeOfDay, version])
  @@unique([id, userId])
  @@index([createdBy])
  @@map("care_routine_revisions")
}

model CareRoutineCompletion {
  id String @id @db.Uuid
  userId String @db.Uuid
  revisionId String @db.Uuid
  completedAt DateTime @db.Timestamp(3)
  localDate String
  timeZone String
  receivedAt DateTime @default(now()) @db.Timestamp(3)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  routine CareRoutineRevision @relation(fields: [revisionId, userId], references: [id, userId], onDelete: Restrict, onUpdate: NoAction)

  @@unique([userId, revisionId, localDate])
  @@index([userId, receivedAt, id])
  @@index([revisionId, userId])
  @@map("care_routine_completions")
}

model PhotoReview {
  photoId String @id @db.Uuid
  reviewerId String @db.Uuid
  reviewedAt DateTime @default(now()) @db.Timestamp(3)
  photo SkinPhoto @relation(fields: [photoId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  reviewer Dermatologist @relation(fields: [reviewerId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  @@index([reviewerId])
  @@map("photo_reviews")
}

model PhotoCleanup {
  photoId String @id @db.Uuid
  userId String @db.Uuid
  photoUrl String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  @@index([userId])
  @@map("photo_cleanup")
}

model CareTemplateRevision {
  id String @id @db.Uuid
  templateId String @db.Uuid
  ownerId String @db.Uuid
  version Int
  name String
  steps Json
  isActive Boolean
  updatedAt DateTime @default(now()) @db.Timestamp(3)
  owner Dermatologist @relation(fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  @@unique([templateId, version])
  @@index([ownerId, updatedAt, id])
  @@map("care_template_revisions")
}
model CareFormRevision {
  id String @id @db.Uuid
  userId String @db.Uuid
  version Int
  createdBy String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamp(3)
  title String
  isActive Boolean
  questions Json
  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  author Dermatologist @relation(fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  responses CareFormResponse[]
  @@unique([userId, version])
  @@unique([id, userId])
  @@index([createdBy])
  @@map("care_form_revisions")
}
model CareFormResponse {
  id String @id @db.Uuid
  userId String @db.Uuid
  formId String @db.Uuid
  submittedAt DateTime @db.Timestamp(3)
  receivedAt DateTime @default(now()) @db.Timestamp(3)
  answers Json
  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  form CareFormRevision @relation(fields: [formId, userId], references: [id, userId], onDelete: Restrict, onUpdate: NoAction)
  @@index([userId, receivedAt, id])
  @@index([formId, userId])
  @@map("care_form_responses")
}
