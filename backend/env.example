# Runtime configuration. Examples only; never copy hosted secrets into this checkout.
DATABASE_URL="postgresql://username:password@localhost:5432/clearaf"
SUPABASE_URL="http://localhost:54321"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
FRONTEND_URL="http://localhost:3000"

# Enrollment configuration (defaults shown; production values require policy review).
LICENSED_STATES="CA,FL,IL,NY,TX"
MINIMUM_PATIENT_AGE="18"
ENROLLMENT_ENFORCEMENT="on"

# Supabase Auth Send Email hook signing secret and Paubox Email API configuration.
SEND_EMAIL_HOOK_SECRET="v1,whsec_REPLACE_WITH_SUPABASE_HOOK_SECRET"
PAUBOX_API_KEY="your-paubox-api-key"
# Retained as an account reference; current shared Paubox endpoint uses the API key only.
PAUBOX_API_USERNAME="your-paubox-api-username"
PAUBOX_FROM="UNZIT <hello@tryunzit.com>"

# Local schema tooling only; not needed by the Cloud Run query client.
DIRECT_URL="postgresql://username:password@localhost:5432/clearaf"
# PORT is supplied by Cloud Run. NODE_ENV=production is set in the container/deploy script.
# JWT_SECRET and AWS/S3 variables are obsolete: runtime auth/storage use Supabase.

# UNZIT billing validation (see .env.example for the local fake adapter).
# Hosted environments use the reviewed Stripe test adapter; live keys are rejected.
BILLING_PROVIDER="stripe_test"
BILLING_RETURN_ORIGIN="https://replace-with-reviewed-api-host.example.invalid"
STRIPE_SECRET_KEY="sk_test_replace_with_test_key"
STRIPE_WEBHOOK_SECRET="whsec_replace_with_test_secret"
STRIPE_API_VERSION="2026-10-28.endive"
