# Copy to .env for local development; configure production values in Vercel.
DATABASE_URL="postgresql://username:password@localhost:5432/clearaf_db"
DIRECT_URL="postgresql://username:password@localhost:5432/clearaf_db"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-project-public-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-server-only-service-role-key"
PORT=3001
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"
# Optional, only for explicitly invoked legacy development account utilities:
# CLEARAF_DEVELOPMENT_PASSWORD="a-unique-password-of-at-least-20-characters"
# Enrollment rules (placeholders until the practice confirms them)
# LICENSED_STATES="CA,FL,IL,NY,TX"
# MINIMUM_PATIENT_AGE=18
# ENROLLMENT_ENFORCEMENT=on   # set "off" only while older iOS builds without enrollment remain installed
