{
  "eligibilityQuestions": [
    {
      "id": "W1",
      "prompt": "Welcome to UNZIT. UNZIT is online acne care from Dr. Amit Om, a board-certified dermatologist. Here is how it works. You answer questions and send photos of your skin. Dr. Om reviews everything himself, usually within 1 to 2 business days, and sends you a treatment plan. If prescription medicine is right for you, he sends it to your pharmacy. UNZIT is not for emergencies. If you ever have an emergency, call 911. Sometimes the safest care is in person. If Dr. Om thinks you need to be seen in person, he will tell you, and he may not prescribe. This visit takes about 10 minutes. You can save and come back.",
      "kind": "attestation",
      "required": true,
      "options": [],
      "fields": [],
      "showWhen": []
    },
