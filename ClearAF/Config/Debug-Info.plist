<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>ClearAF authentication</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>clearaf</string>
			</array>
		</dict>
	</array>
	<key>ClearAFLocalSupabaseAnonKey</key>
	<string>$(CLEARAF_LOCAL_SUPABASE_ANON_KEY)</string>
	<key>ClearAFLocalDeviceHost</key>
	<string>$(CLEARAF_LOCAL_DEVICE_HOST)</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Connect to the development server on your Mac for local testing.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
