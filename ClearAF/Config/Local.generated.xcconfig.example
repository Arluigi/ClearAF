// Copy the local ANON_KEY reported by supabase status (never service_role).
// Local.generated.xcconfig is ignored by git.
CLEARAF_LOCAL_SUPABASE_ANON_KEY = replace-with-local-anon-jwt
// Optional physical Debug device only; empty keeps Simulator loopback.
CLEARAF_LOCAL_DEVICE_HOST =
// Example: CLEARAF_LOCAL_DEVICE_HOST = Aryans-MacBook-Pro.local
